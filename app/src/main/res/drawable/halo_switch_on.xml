<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:endColor="#C45FF0A9"
                android:startColor="#B31FA96A" />
            <stroke
                android:width="1dp"
                android:color="#665FF0A9" />
        </shape>
    </item>
    <item
        android:width="16dp"
        android:height="16dp"
        android:gravity="end|center_vertical"
        android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="#04120B" />
        </shape>
    </item>
</layer-list>
